# =================================================================
# Student Management System - Environment Variables Template
# Copy this file to .env and customize for your environment:
#   cp .env.example .env
# =================================================================

# MySQL Database Configuration
MYSQL_DATABASE=studentdb
MYSQL_USER=studentuser
MYSQL_PASSWORD=studentpass123
MYSQL_ROOT_PASSWORD=root123

# Host Port Bindings
# For local development: bind MySQL to 127.0.0.1 (localhost only)
# For production EC2: you can leave empty to avoid exposing database externally
MYSQL_PORT=3307
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Spring Boot Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Frontend Configuration
VITE_API_URL=/api/students
VITE_HEALTH_URL=/api/health
